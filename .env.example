# ============================================
# REQUIRED: Twitter API Credentials
# ============================================
# Get these from: https://developer.twitter.com/
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable specific features
ENABLE_BOX_SCORE_POSTING=true
ENABLE_TWEET_MONITORING=false

# ============================================
# BOX SCORE SETTINGS
# ============================================
# How often to check for completed games and post scores (in minutes)
# Set to 1 to check every minute for new games
BOX_SCORE_POST_INTERVAL=1

# ============================================
# TWEET MONITORING SETTINGS (Optional)
# ============================================
# Only needed if ENABLE_TWEET_MONITORING=true

# OpenAI API Key for injury detection
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Twitter account to monitor for injury news
# SHAMS_TWITTER_USERNAME=ShamsCharania

# How often to check for new tweets (in minutes)
# TWEET_CHECK_INTERVAL=5

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///nba_agent.db

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# SMART HEAT BOT (Option B - New intelligent bot)
# ============================================
# Anthropic API Key for Claude (required for smart_heat_bot.py)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The bot monitors these Heat Twitter accounts (configured in smart_heat_mcp_server.py):
# Beat Reporters: @IraHeatBeat, @Anthony_Chiang, @AhnFireDigital
# Influencers: @5ReasonsSports, @HeatVsHaters, @MiamiHeatBeat
# Official: @MiamiHEAT, @JimmyButler
# NBA News: @ShamsCharania, @wojespn, @TheSteinLine

# How often to scrape and potentially tweet (recommended: 15-30 minutes)
SMART_BOT_CHECK_INTERVAL=15

# Tweet rate limit (max tweets per day, recommended: 10-20)
SMART_BOT_MAX_TWEETS_PER_DAY=15
